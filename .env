# Defaults for local development. Every value here is safe to commit: local URLs and mock keys only.
# Put real credentials in .env.local (untracked); it overrides this file.

API_PORT=5500
# Local PostGIS from `docker compose up -d db` (published on 5433 to stay clear of a host Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/tournament
MODE=development

FRONTEND_URL=http://localhost:3000

JWT_SECRET=mock-jwt-secret-change-me
JWT_REFRESH_SECRET=mock-jwt-refresh-secret-change-me

# Mailgun
EMAIL_KEY=mock-email-key
EMAIL_DOMAIN=mock.example.com

# AWS S3 (uploads)
AWS_REGION=eu-central-1
AWS_ACCESS_KEY_ID=mock-aws-access-key-id
AWS_SECRET_ACCESS_KEY=mock-aws-secret-access-key
AWS_S3_BUCKET=mock-bucket

# Firebase push notifications. FIREBASE_PRIVATE_KEY is JSON: {"privateKey":"-----BEGIN PRIVATE KEY-----\n..."}
FIREBASE_PROJECT_ID=mock-firebase-project
FIREBASE_PRIVATE_KEY='{"privateKey":"mock"}'
FIREBASE_CLIENT_EMAIL=mock@mock-firebase-project.iam.gserviceaccount.com

# Google OAuth sign-in
GOOGLE_CLIENT_ID=mock-google-client-id
GOOGLE_CLIENT_SECRET=mock-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback

# Challonge bracket sync
CHALLONGE_CLIENT_ID=mock-challonge-client-id
CHALLONGE_CLIENT_SECRET=mock-challonge-client-secret

# Web app (read at build time)
NEXT_PUBLIC_API_URL=http://localhost:5500
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=mock-google-maps-key
