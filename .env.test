# Defaults for the test suites. Mock keys only; override in .env.test.local (untracked).

API_PORT=5500
# Local PostGIS from `docker compose up -d db` (published on 5433 to stay clear of a host Postgres)
DATABASE_URL=postgres://postgres:postgres@localhost:5433/tournament_test
MODE=test

FRONTEND_URL=http://localhost:3000

JWT_REFRESH_SECRET=mock-jwt-refresh-secret-change-me
JWT_SECRET=mock-jwt-secret-change-me

# Email over SMTP. With SMTP_HOST empty, emails are logged by the API instead of sent.
# `docker compose up` points the api container at the bundled Mailpit inbox (http://localhost:8025).
EMAIL_FROM="winning.sh <noreply@localhost>"
SMTP_HOST=
# SMTP_PORT=587
SMTP_PASSWORD=
# true for implicit TLS (port 465); otherwise STARTTLS is used when the server offers it
SMTP_SECURE=
SMTP_USER=

# S3-compatible file storage. Leave S3_ENDPOINT empty for AWS; set it for any other server.
# These defaults match the SeaweedFS container from `docker compose up -d s3`.
S3_ACCESS_KEY_ID=tournament
S3_BUCKET=tournament
S3_ENDPOINT=http://localhost:8333
S3_FORCE_PATH_STYLE=true
S3_REGION=us-east-1
S3_SECRET_ACCESS_KEY=tournament-secret

# Google OAuth sign-in
GOOGLE_CALLBACK_URL=http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=mock-google-client-id
GOOGLE_CLIENT_SECRET=mock-google-client-secret

# Challonge bracket sync
CHALLONGE_CLIENT_ID=mock-challonge-client-id
CHALLONGE_CLIENT_SECRET=mock-challonge-client-secret
