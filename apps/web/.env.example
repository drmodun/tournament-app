# Copy to apps/web/.env.local for `yarn dev`. NEXT_PUBLIC_* values are inlined into the browser bundle at build time.
NEXT_PUBLIC_API_URL=http://localhost:5500

# Optional. Maps use MapLibre with OpenFreeMap tiles and the public Photon geocoder; no keys needed.
# Set these to use your own Photon server or MapLibre style URLs instead.
# NEXT_PUBLIC_GEOCODER_URL=https://photon.komoot.io
# NEXT_PUBLIC_MAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
# NEXT_PUBLIC_MAP_STYLE_URL_DARK=https://tiles.openfreemap.org/styles/dark

# Optional, server side only: how the Next.js server reaches the API when it differs from the browser's URL
# (for example http://api:5500 inside Docker). Falls back to NEXT_PUBLIC_API_URL.
# API_INTERNAL_URL=
