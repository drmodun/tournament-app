# Production settings for deploy/compose.yml. Copy to deploy/.env (untracked) and fill in.
# Compose reads deploy/.env by itself; the .env in the repository root is for development only.

# --- Which parts run here --------------------------------------------------------------------------
# Comma-separated profiles. There is no default: with this line removed only proxy, api, web and docs run.
#   local-db   PostGIS in this stack (otherwise set DATABASE_URL below)
#   local-s3   SeaweedFS in this stack (otherwise set the S3_* endpoint settings below)
#   admin      the admin panel at /admin
COMPOSE_PROFILES=local-db,local-s3

# --- Images ----------------------------------------------------------------------------------------
# Tags pushed by .github/workflows/images.yml: latest (main), sha-<short commit>, and 1.2.3 / 1.2 for v* tags
IMAGE_TAG=latest
# IMAGE_PREFIX=ghcr.io/drmodun/tournament-app

# --- Address ---------------------------------------------------------------------------------------
# What people open in the browser. Email links, CORS and uploaded file URLs are built from it.
PUBLIC_URL=https://tournament.example.com

# Behind a reverse proxy (nginx, a Cloudflare tunnel) Caddy listens on plain HTTP. Choose where:
#   - a proxy on the host connects to 127.0.0.1:${PROXY_HTTP_PORT}
#   - a proxy in another container joins EDGE_NETWORK and connects to ${EDGE_ALIAS}:80
# PROXY_HTTP_PORT=127.0.0.1:8080
# PROXY_HTTPS_PORT=127.0.0.1:8443
# EDGE_NETWORK=nginx_default
# EDGE_ALIAS=tournament-app
#
# With nothing in front, Caddy serves HTTPS itself and needs ports 80 and 443:
# SITE_ADDRESS=tournament.example.com
# PROXY_HTTP_PORT=0.0.0.0:80
# PROXY_HTTPS_PORT=0.0.0.0:443

# --- Secrets ---------------------------------------------------------------------------------------
# Generate each with: openssl rand -hex 32
JWT_SECRET=
JWT_REFRESH_SECRET=
# Optional; derived from JWT_SECRET when empty
# SSE_TOKEN_SECRET=

# --- Database --------------------------------------------------------------------------------------
# With local-db: the password of the bundled PostGIS. It goes into a URL, so stick to letters and digits.
POSTGRES_PASSWORD=
# Without local-db: a Postgres 16 server with the PostGIS extension available (the migrations enable it)
# DATABASE_URL=postgres://user:password@10.0.0.12:5432/tournament

# --- File storage ----------------------------------------------------------------------------------
# With local-s3 these keys are also the bundled SeaweedFS credentials; pick any values
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
# S3_BUCKET=tournament
# Without local-s3, point at the bucket's server:
#   Cloudflare R2: S3_ENDPOINT=https://<account id>.r2.cloudflarestorage.com  S3_REGION=auto
#   AWS S3:        S3_ENDPOINT= (empty)  S3_REGION=eu-central-1  S3_FORCE_PATH_STYLE=false
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_FORCE_PATH_STYLE=true

# --- Email -----------------------------------------------------------------------------------------
# Required in production. Amazon SES, for example:
EMAIL_FROM="winning.sh <noreply@tournament.example.com>"
SMTP_HOST=email-smtp.eu-central-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# true for implicit TLS on port 465; otherwise STARTTLS is used
# SMTP_SECURE=

# --- Optional integrations -------------------------------------------------------------------------
# Google sign-in; the callback defaults to ${PUBLIC_URL}/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_CALLBACK_URL=

# Brackets run in the API unless Challonge is enabled
# CHALLONGE_ENABLED=true
# CHALLONGE_CLIENT_ID=
# CHALLONGE_CLIENT_SECRET=

# Extra browser origins allowed to call the API (comma-separated); PUBLIC_URL is always allowed
# CORS_ORIGIN=

# --- Limits ----------------------------------------------------------------------------------------
# API_MEMORY_LIMIT=512m
# WEB_MEMORY_LIMIT=512m

# Vansy exam platform (quizzes, competitions, proctoring). Off unless both are set.
# VANSY_URL is Vansy's API as this server reaches it, e.g. https://quiz.example.com/api
VANSY_URL=
# This app's Ed25519 private JWK (from Vansy: yarn workspace api keys:generate tournaments);
# its public half goes into Vansy's tenant file
VANSY_PRIVATE_KEY=
VANSY_TENANT_ID=tournaments
# Optional: Vansy's public JWK; otherwise read from VANSY_URL/v1/.well-known/jwks.json
VANSY_PUBLIC_KEY=
