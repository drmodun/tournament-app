# nginx in front of deploy/compose.yml. Caddy inside the stack routes /api, /docs and /admin,
# so nginx only terminates TLS and forwards everything to it.
#
# nginx in a container: join the stack's edge network (EDGE_NETWORK) and use the alias, as below.
# nginx on the host:    use `proxy_pass http://127.0.0.1:8080;` (PROXY_HTTP_PORT) instead.

server {
    listen 443 ssl;
    http2 on;
    server_name tournament.example.com;

    ssl_certificate     /etc/letsencrypt/live/tournament.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/tournament.example.com/privkey.pem;

    # Image uploads are up to 5 MB; nginx's default limit is 1 MB
    client_max_body_size 6m;

    location / {
        # A variable makes nginx resolve the name per request, so it starts even while the stack is down
        resolver 127.0.0.11 valid=30s;
        set $tournament http://tournament-app:80;
        proxy_pass $tournament;

        proxy_http_version 1.1;
        proxy_set_header Connection "";
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # Notifications are server-sent events: pass them through unbuffered and keep the stream open
        proxy_buffering off;
        proxy_read_timeout 1h;
    }
}

server {
    listen 80;
    server_name tournament.example.com;
    return 301 https://$host$request_uri;
}
