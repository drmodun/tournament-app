{
  "name": "with-docker",
  "version": "0.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "lint": "turbo run lint",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e"
  },
  "dependencies": {},
  "devDependencies": {
    "@repo/eslint-config": "*",
    "prettier": "^3.9.10",
    "turbo": "^2.11.7"
  },
  "resolutions": {
    "**/@nestjs/swagger/js-yaml": "^5.4.1",
    "**/react-swipeable-views/@babel/runtime": "^7.26.10",
    "**/react-swipeable-views-core/@babel/runtime": "^7.26.10",
    "**/react-swipeable-views-utils/@babel/runtime": "^7.26.10"
  },
  "packageManager": "yarn@1.22.22",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=7.0.0"
  }
}
